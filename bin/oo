#!/usr/bin/env bash
# bin/oo — deterministic CLI for the fleet's OpenObserve instance (LXC 106).
#
# WHY this exists: 2026-08-23 incident response needed "what did this
# container print before it got redeployed" — `docker logs` only shows the
# CURRENT container instance's output, so a redeploy silently loses
# history. Every docker host now runs a Vector shipper
# (/opt/observability/vector-log-shipper/ on each host) that forwards
# every container's stdout/stderr into OpenObserve's `docker_logs` stream,
# tagged with container_name/host/image/compose labels — independent of
# container lifecycle. This script is the deterministic way to query it,
# so nobody has to hand-roll curl + inline python timestamp math again.
#
# All requests are proxied through the bastion via SSH — OpenObserve's
# LAN address (see fleet-state/OPS.md) is only reachable from inside
# the 0docker.com private LAN, not from an operator's workstation
# directly.
#
# USAGE:
#   oo query <sql> [--since DURATION] [--limit N] [--pretty]
#       Run an arbitrary SQL query against a stream (default org "default").
#       The stream name goes in the SQL's FROM clause, e.g.
#       'SELECT * FROM docker_logs WHERE ...'. Output is compact JSON with
#       OpenObserve's own response metadata stripped by default (this is
#       the escape hatch most likely to be parsed by a script/agent, not
#       eyeballed — compact + stripped runs ~17-25% smaller than the old
#       always-pretty-printed shape); pass --pretty for indented JSON with
#       full metadata (took_detail, trace_id, etc) when a human wants to
#       read it directly.
#
#   oo logs <container_name> [--since DURATION] [--grep PATTERN] [--limit N] [--host HOST]
#       Convenience wrapper: every log line for one container, newest
#       first. --grep does a substring match on the message field.
#       --host disambiguates if the same container name exists on more
#       than one docker host (rare, but container names aren't globally
#       unique across the fleet).
#
#   oo grep <pattern> [--since DURATION] [--container NAME] [--host HOST] [--limit N]
#       Full-text search across EVERY container fleet-wide (not just one
#       you already know the name of) — the actual "grep the fleet"
#       capability. Scope with --container / --host if you already know
#       where to look; omit both to search everywhere.
#
#   oo errors [container_name] [--since DURATION] [--host HOST] [--limit N]
#       Shortcut for the #1 incident-response query: lines whose message
#       looks like an error (case-insensitive match on error/fatal/
#       panic, excluding the "error":null / error=<nil> false positives
#       this fleet's own logging idioms produce — see ERROR_LIKE_CLAUSE).
#       Omit container_name to scan the whole fleet.
#
#   oo since-redeploy <container_name> [--host HOST] [--window DURATION] [--before DURATION] [--after DURATION] [--limit N]
#       THE command this tool exists for: finds the earliest log line
#       for the container's CURRENT instance within the lookback
#       --window (default 24h — widen it if the container has been up
#       longer than that and this comes back empty), then shows
#       everything from --before that point through --after it
#       (defaults 5m / 10m). That's the exact "what happened right when
#       this thing (re)started" view that redeploying blind loses.
#       Approximate, not exact: it's the earliest line seen in the
#       window, not a real process-start timestamp — good enough for
#       "did this come up clean" in practice.
#
#   oo containers [--since DURATION] [--host HOST] [--limit N]
#       Discover what's actually logging: container_name + host, line
#       count, and last-seen time, sorted noisiest-first. Answers "what
#       containers exist" and "what's chatty" in one shot.
#
#   oo hosts [--since DURATION]
#       Which docker hosts are shipping to docker_logs, with line count
#       and distinct-container count per host. Sanity-check after adding
#       a new host's vector-log-shipper.
#
#   oo context <container_name> <timestamp> [--before DURATION] [--after DURATION] [--host HOST] [--limit N]
#       Generalizes since-redeploy's window logic to any point in time,
#       not just a container's start: given a timestamp you already
#       found interesting (epoch seconds or ISO8601), show what else
#       that container logged right around it. --before/--after default
#       2m/2m.
#
#   oo compare <container1> <container2> [--since DURATION] [--limit N] [--host HOST]
#       Interleave two containers' log lines in one timestamp-ordered
#       stream, each tagged [host] <name>. For correlating a request across
#       two services (api + its proxy, prod + staging, etc). --host applies
#       to both containers — use it if either name is ambiguous across hosts.
#
#   oo restarts <container_name> [--since DURATION] [--gap DURATION] [--host HOST]
#       Infers apparent restarts by finding gaps larger than --gap
#       (default 30s) in the container's log timeline within --since
#       (default 24h) — no docker inspect / SSH-to-host needed. A real
#       gap means either a crash/restart or a genuinely quiet period;
#       cross-check with --gap tuned to the container's normal chattiness.
#
#   oo rate <container_name> [--since DURATION] [--bucket DURATION] [--host HOST]
#       Lines-per-bucket histogram (default: 1h window, 5m buckets) —
#       spot volume spikes or drops at a glance without hand-writing a
#       GROUP BY.
#
#   oo versions <container_name> [--since DURATION] [--host HOST]
#       Distinct `image` values seen for a container, each with
#       first/last-seen and line count — an image tag change is a
#       deploy; this is deploy history without touching git or GHCR.
#
#   oo new [--since DURATION] [--baseline DURATION]
#       container_names seen in the last --since (default 1h) that were
#       NOT seen in the --baseline period before that (default 24h) —
#       flags unexpected churn: a container that just started existing.
#
#   oo check <container_name> [--since DURATION] [--host HOST]
#       Scriptable health check: exit 0 + "OK" if no error-looking lines
#       in --since (default 15m), exit 1 + "FAIL" (with count) if there
#       are, exit 2 + "UNKNOWN" if the check itself couldn't run (bad
#       creds, malformed query, etc) — deliberately distinct from FAIL so
#       a caller that cares can tell "definitely has errors" apart from
#       "couldn't tell"; `if oo check X` treats either as not-confirmed-
#       healthy either way, which is the safe default. Built for
#       scripting, not for reading — no pretty-printing, one line of
#       output.
#
#   oo save <name> <sql>
#   oo saved
#   oo run <name> [--since DURATION] [--limit N] [--pretty]
#       Bookmark a query once (locally, in ~/.oo/queries.json — never
#       synced or committed), list what's saved, re-run one by name
#       instead of retyping SQL every session. `run`'s output follows
#       `query`'s same compact-by-default / --pretty convention.
#
#   oo summary [--since DURATION]
#       One-shot fleet orientation: host breakdown, top 8 noisiest
#       containers, top 8 error-containers. Start an investigation here
#       instead of four separate round trips.
#
#   oo link <sql> [--since DURATION]
#       Prints the web UI URL plus the query and resolved time range as
#       copy-paste text, for handing a query off to a human instead of
#       (or in addition to) reading the CLI output yourself.
#
#   oo tail <container_name> [--interval SECONDS] [--host HOST]
#       Polling tail (default 3s interval) — not a true push/websocket
#       stream. Good enough for "watch this thing after I redeploy it";
#       for a real live-tail UI, use https://openobserve.0docker.com
#       directly (ZO_WEBSOCKET_ENABLED is on).
#
#   oo streams
#       List every stream in the org with doc count / time range / size.
#
#   oo stream-info <stream_name>
#       Full schema for one stream — every field name + type (e.g.
#       container_name: Utf8, _timestamp: Int64) plus stats — the
#       drill-down when `oo streams`' one-line summary isn't enough,
#       and the answer to "what fields can I write a WHERE clause
#       against" before hand-writing an `oo query`.
#
# DURATION: Ns / Nm / Nh / Nd (default: 1h). Examples: 30s, 15m, 2h, 3d.
#
# ENV (required): OPENOBSERVE_USER, OPENOBSERVE_PASSWORD, OPENOBSERVE_HOST
#   — see bin/fleet-runner.env.example. Real values live in
#   fleet-state/OPS.md (private) — never hardcode them here, this repo
#   is public.
# ENV (optional): FLEET_BASTION (default root@0docker.com),
#   OPENOBSERVE_PORT (default 5080), OO_SAVE_DIR (default ~/.oo — where
#   `oo save`/`oo run` keep bookmarked queries, local to your machine).
#
# Known limitation: credentials are passed to curl via -u on the bastion's
# command line. Verified 2026-08-24 (fourth independent review): the
# bastion's curl (7.88.1, Debian 12) has built-in -u argument-hiding — per
# `man curl`, it overwrites that option's argv value in its own process
# memory right after parsing, before the request goes out. Live-tested
# against real traffic: 20 concurrent `oo query` calls sampled by a tight,
# sleepless `ps` loop on the bastion (62 curl-process snapshots captured)
# never once caught the credentials in cleartext. So actual exposure is far
# smaller than "visible during the request" suggests — though curl's own
# docs stop short of a zero-exposure guarantee ("still be visible for a
# moment before cleared"), and the mitigation lives in the REMOTE curl
# binary, not this script — it silently stops applying if FLEET_BASTION
# ever points at a host with an older/different curl. No script-level fix
# was layered on top: a netrc-file alternative would need its own remote
# temp file over SSH (stdin here already carries the query payload via
# --data-binary @-), adding real complexity for a risk that's already
# near-zero in practice, on a bastion reachable only by the fleet's small
# trusted operator set (see services-registry/CLAUDE.md). Still, don't
# reuse this -u pattern for anything internet-facing.

set -euo pipefail

BASTION="${FLEET_BASTION:-root@0docker.com}"
OO_HOST="${OPENOBSERVE_HOST:-}"
OO_PORT="${OPENOBSERVE_PORT:-5080}"
OO_ORG="${OPENOBSERVE_ORG:-default}"
OO_SAVE_DIR="${OO_SAVE_DIR:-$HOME/.oo}"
OO_SAVE_FILE="${OO_SAVE_DIR}/queries.json"

# Heuristic "this line looks like an error" match, shared by errors/check/
# summary. Tuned twice against REAL fleet data (2026-08-23), not just
# domainscope-api:
#
#   Excludes (false positives found by sampling matches across the top
#   error-count containers fleet-wide, not just the one that motivated
#   the tool):
#     - "error":null / error=<nil> / error: <nil> — this fleet's own
#       structured-logging idiom for "no error occurred" (JSON and Go
#       logfmt both literally contain the substring "error" even when
#       stating its absence). domainscope-api alone was ~80%
#       false-positive on the naive version before this exclusion.
#     - state=Error — Grafana's alerting engine uses "Error" as one
#       enum value of an alert's evaluation state; "Detected stale
#       state entry ... state=Error" is routine INFO-level cache
#       housekeeping, not an active problem. 46% of go-fleet-grafana's
#       naive matches were this one shape.
#
#   Adds (false negatives found by grep-ing for other common failure
#   words NOT already covered, then sampling the matches to check they
#   were genuine — "failed to" and "crash" were tried and REJECTED here
#   because they matched high-volume benign noise instead: "failed to"
#   is dominated by a benign `DEBUG: Failed to open service.yaml`
#   boilerplate line shared by dozens of pentest-tool containers on
#   startup, and "crash" matched a proxied page's URL containing the
#   word as part of a GitHub repo name, not an actual crash):
#     - refused — real ECONNREFUSED monitor-down alerts from
#       0init-uptime-kuma, a single clean source with zero observed
#       false positives in this sample.
#
# Not exhaustive — a log shape nobody's tested against yet could still
# slip through in either direction; re-validate the same way (sample
# top containers under `errors`/`summary`, grep for un-covered failure
# words, check volume + a real sample before adding/excluding anything)
# rather than guessing.
ERROR_LIKE_CLAUSE="(message ILIKE '%error%' OR message ILIKE '%fatal%' OR message ILIKE '%panic%' OR message ILIKE '%refused%') AND message NOT ILIKE '%\"error\":null%' AND message NOT ILIKE '%error=<nil>%' AND message NOT ILIKE '%error: <nil>%' AND message NOT ILIKE '%state=Error%'"

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

require_creds() {
  : "${OPENOBSERVE_USER:?OPENOBSERVE_USER is not set — see bin/fleet-runner.env.example}"
  : "${OPENOBSERVE_PASSWORD:?OPENOBSERVE_PASSWORD is not set — see bin/fleet-runner.env.example}"
  : "${OO_HOST:?OPENOBSERVE_HOST is not set — see bin/fleet-runner.env.example / fleet-state/OPS.md}"
  BASE_URL="http://${OO_HOST}:${OO_PORT}"
}

duration_to_seconds() {
  local d="$1" num unit
  unit="${d: -1}"
  num="${d%[smhd]}"
  if ! [[ "$num" =~ ^[0-9]+$ ]]; then
    echo "invalid duration: $d (use Ns/Nm/Nh/Nd, e.g. 30s, 15m, 2h, 3d)" >&2
    exit 1
  fi
  case "$unit" in
    s) echo "$num" ;;
    m) echo $((num * 60)) ;;
    h) echo $((num * 3600)) ;;
    d) echo $((num * 86400)) ;;
    *) echo "invalid duration: $d (use Ns/Nm/Nh/Nd, e.g. 30s, 15m, 2h, 3d)" >&2; exit 1 ;;
  esac
}

# sql_escape VALUE — standard SQL string-literal escaping (' -> ''). Apply
# to every user-controlled value interpolated into a WHERE clause built by
# this script (container names, host labels, grep/errors patterns) BEFORE
# building the clause. Do NOT apply this to raw SQL the user hands in
# directly (`query`/`save`/`run`/`link` take arbitrary SQL by design).
#
# Found live 2026-08-23 (independent review): before this existed, a
# container name or grep pattern containing a single quote (e.g. grepping
# for "can't connect") broke the generated SQL and — worse — the broken
# query's error response was indistinguishable from "zero results" to
# every formatter below, so the tool silently told the operator "nothing
# found" instead of "your query was malformed". See the _oo_error
# mechanism in oo_search_range for the other half of that fix.
sql_escape() {
  printf '%s' "${1//\'/\'\'}"
}

# oo_search_range SQL START_US END_US LIMIT — the primitive: an absolute
# microsecond-epoch time range. ALWAYS prints valid JSON to stdout: either
# OpenObserve's real response (which has a "hits" key), or, on any
# failure (malformed SQL, auth failure, a non-JSON response like the
# plain-text "Unauthorized Access" OpenObserve returns on bad creds),
# {"_oo_error": "<message>"} — never a raw traceback, and never silence
# that a caller could mistake for "zero results". Every downstream
# formatter in this file checks for "_oo_error" first, before touching
# "hits" — copy that pattern for any new command you add.
oo_search_range() {
  local sql="$1" start_us="$2" end_us="$3" limit="$4"
  local payload rc=0
  # Found live 2026-08-24 (second independent review): a non-numeric
  # --limit (or a corrupted start/end) used to blow up the int() cast
  # below with an UNCAUGHT traceback — which broke the "always valid
  # JSON on stdout" contract this function documents, and left every
  # downstream formatter (none of which try/except json.load) to choke
  # on the resulting empty stdin with a second, unrelated traceback of
  # its own. Catch it here and fold it into the same _oo_error shape as
  # every other failure mode in this function, so a fat-fingered
  # `--limit abc` (or an injection attempt using --limit as the vector)
  # fails exactly like a malformed --since or bad creds does.
  payload=$(python3 -c '
import json, sys
try:
    sql, start, end, size = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
except ValueError as e:
    print(json.dumps({"_oo_error": "invalid numeric argument (--limit or time range): " + str(e)}))
    sys.exit(1)
print(json.dumps({"query": {"sql": sql, "start_time": start, "end_time": end, "size": size}}))
' "$sql" "$start_us" "$end_us" "$limit") || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    printf '%s\n' "$payload"
    return 0
  fi
  # --connect-timeout / --max-time: found live 2026-08-24 (scenario-plan
  # review, garbage-input case) — with no timeout at all, a wrong/
  # unreachable OPENOBSERVE_HOST hung for 132s (the OS's own TCP connect
  # timeout) before curl finally gave up, with zero feedback the whole
  # time. 10s to establish the connection and 60s total is generous for
  # every query this file issues in practice (all observed well under
  # 5s) while bounding the worst case to "fails within a minute with a
  # clear error" instead of "silently hangs for two-plus minutes."
  ssh "$BASTION" "curl -sS --connect-timeout 10 --max-time 60 -u '${OPENOBSERVE_USER}:${OPENOBSERVE_PASSWORD}' -X POST ${BASE_URL}/api/${OO_ORG}/_search -H 'Content-Type: application/json' --data-binary @-" <<<"$payload" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
    if "hits" not in d:
        raise ValueError(d.get("message", raw)[:500])
except json.JSONDecodeError:
    # Found live 2026-08-24 (garbage-input scenario review): the old
    # except (json.JSONDecodeError, ValueError) as e: print(str(e))
    # shape surfaced the JSON decoder own complaint ("Expecting value:
    # line 1 column 1 (char 0)") for BOTH a non-JSON response body (bad
    # creds, where OpenObserve returns the plain-text "Unauthorized
    # Access") and a completely empty body (curl itself failed before
    # any response came back, e.g. connection refused/timed out --- its
    # diagnostic goes to stderr, not this stdin) --- neither case told
    # the operator anything about what actually went wrong. Split it
    # out: echo the real (truncated) response body when there is one,
    # and call out "empty response" (pointing at the curl error likely
    # already printed above, and at network/host config) when not.
    body = raw.strip()
    if body:
        msg = "non-JSON response from OpenObserve: " + body[:300]
    else:
        msg = "empty response (connection/timeout failure talking to OpenObserve — check OPENOBSERVE_HOST/network, and any curl error printed above)"
    print(json.dumps({"_oo_error": msg}))
except ValueError as e:
    print(json.dumps({"_oo_error": str(e)}))
else:
    sys.stdout.write(raw)
'
}

# oo_search SQL SINCE_DURATION LIMIT — the common case: relative to now.
# Same "always valid JSON, _oo_error on failure" contract as
# oo_search_range — an invalid --since duration is normalized into the
# same shape rather than a bare `exit 1`, which (found live 2026-08-23)
# only killed the subshell running this function's half of the caller's
# pipe, not the caller itself, leaving the downstream formatter to choke
# on empty stdin with a raw Python traceback instead of a clean message.
oo_search() {
  local sql="$1" since="$2" limit="$3"
  local end_us start_us secs
  if ! secs=$(duration_to_seconds "$since" 2>&1); then
    python3 -c 'import json, sys; print(json.dumps({"_oo_error": sys.argv[1]}))' "$secs"
    return 0
  fi
  end_us=$(( $(date +%s) * 1000000 ))
  start_us=$(( end_us - secs * 1000000 ))
  oo_search_range "$sql" "$start_us" "$end_us" "$limit"
}

# format_search_result — shared by query/run: prints _oo_error to stderr
# and exits 1, otherwise prints the result either compact (default — this
# is the raw-JSON escape hatch most likely to be consumed by an agent, not
# a human eyeballing a terminal, and pretty-printing plus OpenObserve's own
# response metadata roughly doubles the byte count for no benefit to a
# parser) or pretty + full metadata with --pretty.
format_search_result() {
  local pretty="$1"
  python3 -c '
import json, sys
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
pretty = sys.argv[1] == "1"
if pretty:
    print(json.dumps(d, indent=4))
else:
    noise = ("took", "took_detail", "trace_id", "cached_ratio", "scan_size",
              "idx_scan_size", "scan_records", "result_cache_ratio",
              "is_partial", "from", "order_by")
    compact = {k: v for k, v in d.items() if k not in noise}
    print(json.dumps(compact, separators=(",", ":")))
' "$pretty"
}

cmd_query() {
  local sql="${1:?usage: oo query <sql> [--since 1h] [--limit 100] [--pretty]}"; shift || true
  local since="1h" limit="100" pretty="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --pretty) pretty="1"; shift ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  oo_search "$sql" "$since" "$limit" | format_search_result "$pretty"
}

cmd_logs() {
  local container="${1:?usage: oo logs <container_name> [--since 1h] [--grep pattern] [--limit 100] [--host HOST]}"; shift || true
  local since="1h" limit="100" grep_pat="" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --grep) grep_pat="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  grep_pat=$(sql_escape "$grep_pat")
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  [[ -n "$grep_pat" ]] && where="${where} AND message LIKE '%${grep_pat}%'"
  local sql="SELECT _timestamp, host, container_name, stream, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("(no matching log lines — check --since / --host / container name)", file=sys.stderr)
for h in reversed(hits):
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
'
}

cmd_grep() {
  local pattern="${1:?usage: oo grep <pattern> [--since 1h] [--container NAME] [--host HOST] [--limit 100]}"; shift || true
  local since="1h" limit="100" container_filter="" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --container) container_filter="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  pattern=$(sql_escape "$pattern")
  container_filter=$(sql_escape "$container_filter")
  host_filter=$(sql_escape "$host_filter")
  local where="message LIKE '%${pattern}%'"
  [[ -n "$container_filter" ]] && where="${where} AND container_name = '${container_filter}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local sql="SELECT _timestamp, host, container_name, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("(no matches — check --since / --container / --host / pattern)", file=sys.stderr)
for h in reversed(hits):
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    name = h.get("container_name", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}/{name}] {msg}")
'
}

cmd_errors() {
  local container="" since="1h" limit="100" host_filter=""
  if [[ $# -gt 0 && "${1:0:2}" != "--" ]]; then
    container="$1"; shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="${ERROR_LIKE_CLAUSE}"
  [[ -n "$container" ]] && where="${where} AND container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local sql="SELECT _timestamp, host, container_name, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("(no error-looking lines — check --since / container / --host)", file=sys.stderr)
for h in reversed(hits):
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    name = h.get("container_name", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}/{name}] {msg}")
'
}

cmd_since_redeploy() {
  local container="${1:?usage: oo since-redeploy <container_name> [--host HOST] [--window 24h] [--before 5m] [--after 10m] [--limit 500]}"; shift || true
  local window="24h" before="5m" after="10m" limit="500" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host_filter="$2"; shift 2 ;;
      --window) window="$2"; shift 2 ;;
      --before) before="$2"; shift 2 ;;
      --after) after="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"

  echo "# finding the earliest log line for '${container}' in the last ${window} (approximates its current instance's start — widen --window if it's been up longer than that)" >&2
  local first_seen
  first_seen=$(oo_search "SELECT min(_timestamp) as first_seen FROM docker_logs WHERE ${where}" "$window" 1 | python3 -c '
import json, sys
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
fs = hits[0].get("first_seen") if hits else None
print(fs if fs is not None else "")
')
  if [[ -z "$first_seen" ]]; then
    echo "no log lines found for '${container}' in the last ${window} — check the container name / --host, or widen --window" >&2
    exit 1
  fi

  local first_seen_human before_secs after_secs first_secs now_secs start_us end_us
  # $first_seen goes to python via argv, not interpolated into the script
  # text — matches the argv-passing fix applied to cmd_stream_info. The
  # old version spliced ${first_seen} directly into a bash DOUBLE-quoted
  # -c string, which meant a value containing backticks/$(...) would be
  # expanded and executed by bash before python ever saw it. In normal
  # operation $first_seen is a numeric _timestamp from OpenObserve's own
  # min() aggregate, not free-form user text, so this was low practical
  # exploitability — but it's the same unsafe shape, closed the same way.
  first_seen_human=$(python3 -c '
import sys, datetime
print(datetime.datetime.fromtimestamp(int(sys.argv[1]) / 1e6, datetime.UTC).isoformat())
' "$first_seen")
  echo "# earliest line found at ${first_seen_human} UTC — showing --before ${before} through --after ${after} around it" >&2
  before_secs=$(duration_to_seconds "$before")
  after_secs=$(duration_to_seconds "$after")
  first_secs=$(( first_seen / 1000000 ))
  now_secs=$(date +%s)
  start_us=$(( (first_secs - before_secs) * 1000000 ))
  end_us=$(( (first_secs + after_secs) * 1000000 ))
  (( end_us > now_secs * 1000000 )) && end_us=$(( now_secs * 1000000 ))

  local sql="SELECT _timestamp, host, message FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search_range "$sql" "$start_us" "$end_us" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("(no log lines in that window)", file=sys.stderr)
for h in hits:
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
'
}

cmd_context() {
  local container="${1:?usage: oo context <container_name> <timestamp> [--before 2m] [--after 2m] [--host HOST] [--limit 500]}"; shift || true
  local ts="${1:?usage: oo context <container_name> <timestamp> [--before 2m] [--after 2m] [--host HOST] [--limit 500]}"; shift || true
  local before="2m" after="2m" host_filter="" limit="500"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --before) before="$2"; shift 2 ;;
      --after) after="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"

  local center_secs
  center_secs=$(python3 -c '
import sys, datetime
v = sys.argv[1]
try:
    print(int(v))
except ValueError:
    try:
        dt = datetime.datetime.fromisoformat(v.replace("Z", "+00:00"))
        print(int(dt.timestamp()))
    except Exception:
        print(f"invalid timestamp: {v} (use epoch seconds or ISO8601)", file=sys.stderr)
        sys.exit(1)
' "$ts")

  local before_secs after_secs start_us end_us now_us
  before_secs=$(duration_to_seconds "$before")
  after_secs=$(duration_to_seconds "$after")
  start_us=$(( (center_secs - before_secs) * 1000000 ))
  end_us=$(( (center_secs + after_secs) * 1000000 ))
  now_us=$(( $(date +%s) * 1000000 ))
  (( end_us > now_us )) && end_us=$now_us

  local sql="SELECT _timestamp, host, message FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search_range "$sql" "$start_us" "$end_us" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("(no log lines in that window)", file=sys.stderr)
for h in hits:
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
'
}

cmd_compare() {
  local c1="${1:?usage: oo compare <container1> <container2> [--since 15m] [--limit 100] [--host HOST]}"; shift || true
  local c2="${1:?usage: oo compare <container1> <container2> [--since 15m] [--limit 100] [--host HOST]}"; shift || true
  local since="15m" limit="100" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  c1=$(sql_escape "$c1")
  c2=$(sql_escape "$c2")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name IN ('${c1}', '${c2}')"
  # Every other per-container command (logs/grep/errors/since-redeploy/
  # context/restarts/rate/versions/check/tail) takes --host, because
  # container names aren't globally unique across the fleet (see the
  # header docs). compare was missing it — found live 2026-08-24 (third
  # independent review, hunting for flag-consistency gaps rather than the
  # already-fixed SQL-escaping/_oo_error classes). It also silently
  # dropped `host` from its own output, so even without the filter there
  # was no way to tell which host an ambiguous line came from; both are
  # fixed together here the same way logs/grep already do it.
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local sql="SELECT _timestamp, host, container_name, message FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("(no matching log lines — check --since / --host / container names)", file=sys.stderr)
for h in hits:
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    name = h.get("container_name", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] <{name}> {msg}")
'
}

cmd_restarts() {
  local container="${1:?usage: oo restarts <container_name> [--since 24h] [--gap 30s] [--host HOST] [--limit 5000]}"; shift || true
  local since="24h" gap="30s" host_filter="" limit="5000"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --gap) gap="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local gap_secs
  gap_secs=$(duration_to_seconds "$gap")
  local sql="SELECT _timestamp FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
gap_secs = int(sys.argv[1])
container = sys.argv[2]
since_label = sys.argv[3]
limit = int(sys.argv[4])
gap_us = gap_secs * 1000000
if len(hits) < 2:
    print("not enough data to detect gaps (need >=2 lines) — check --since / --host / container name", file=sys.stderr)
    sys.exit(0)
# Same truncation risk as `rate` (see its comment): ORDER BY _timestamp
# ASC LIMIT <limit> means a container noisier than --limit rows within
# --since only gets gap-checked up through wherever the row cap landed,
# not through "now" — so "no gaps found" can mean "genuinely up the
# whole time" OR "we stopped looking before the window ended." Warn
# rather than let a truncated scan read as a clean bill of health.
if len(hits) >= limit:
    print(f"warning: hit --limit ({limit}) rows before reaching the end of --since — gap-checking only covered up to the last returned line, not the full window; increase --limit to check the rest", file=sys.stderr)
prev = hits[0]["_timestamp"]
found = 0
for h in hits[1:]:
    cur = h["_timestamp"]
    if cur - prev > gap_us:
        gap_s = (cur - prev) / 1e6
        t1 = datetime.datetime.fromtimestamp(prev/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
        t2 = datetime.datetime.fromtimestamp(cur/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
        print(f"gap of {gap_s:.0f}s: {t1} .. {t2} UTC (likely restart or quiet period)")
        found += 1
    prev = cur
if found == 0:
    print(f"no gaps > {gap_secs}s found in the last {since_label} — {container} looks continuously up")
' "$gap_secs" "$container" "$since" "$limit"
}

cmd_rate() {
  local container="${1:?usage: oo rate <container_name> [--since 1h] [--bucket 5m] [--host HOST] [--limit 10000]}"; shift || true
  local since="1h" bucket="5m" host_filter="" limit="10000"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --bucket) bucket="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local bucket_secs
  bucket_secs=$(duration_to_seconds "$bucket")
  local sql="SELECT _timestamp FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime, collections
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
bucket_us = int(sys.argv[1]) * 1000000
limit = int(sys.argv[2])
if not hits:
    print("no data in window — check --since / --host / container name", file=sys.stderr)
    sys.exit(0)
# Found live 2026-08-24 (scenario-plan review, "is traffic dropping or
# spiking" scenario): the query is ORDER BY _timestamp ASC LIMIT
# <limit>, so for a container noisier than --limit rows within --since,
# the result silently stops at whatever moment the row cap was hit --
# NOT at "now". Confirmed live: go-html-proxy over --since 6h at the
# default --limit 10000 rendered a histogram that dropped to nothing
# after ~90 minutes, looking exactly like a traffic collapse; bumping
# --limit 10x revealed traffic had actually INCREASED for the next
# hour. Warn instead of presenting a truncated tail as if it were the
# real recent trend.
if len(hits) >= limit:
    print(f"warning: hit --limit ({limit}) rows before reaching the end of --since — the last bucket(s) below likely do NOT reflect the full window; increase --limit for the true recent trend", file=sys.stderr)
counts = collections.Counter()
for h in hits:
    counts[h["_timestamp"] // bucket_us] += 1
maxc = max(counts.values())
for k in sorted(counts):
    t = datetime.datetime.fromtimestamp(k * bucket_us / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M")
    n = counts[k]
    bar = "#" * max(1, int(n / maxc * 40))
    print(f"{t}  {n:>6}  {bar}")
' "$bucket_secs" "$limit"
}

cmd_versions() {
  local container="${1:?usage: oo versions <container_name> [--since 7d] [--host HOST]}"; shift || true
  local since="7d" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local sql="SELECT image, min(_timestamp) as first_seen, max(_timestamp) as last_seen, count(*) as n FROM docker_logs WHERE ${where} GROUP BY image ORDER BY last_seen DESC"
  oo_search "$sql" "$since" 100 | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("no data — check container name / --since / --host", file=sys.stderr)
for h in hits:
    img = h.get("image", "?")
    fs = datetime.datetime.fromtimestamp(h["first_seen"]/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
    ls = datetime.datetime.fromtimestamp(h["last_seen"]/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
    n = h.get("n", 0)
    print(f"{img}\n  first_seen={fs}  last_seen={ls}  lines={n}")
'
}

cmd_new() {
  local since="1h" baseline="24h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --baseline) baseline="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local since_secs baseline_secs now_secs now_us recent_start_us baseline_start_us
  since_secs=$(duration_to_seconds "$since")
  baseline_secs=$(duration_to_seconds "$baseline")
  now_secs=$(date +%s)
  now_us=$(( now_secs * 1000000 ))
  recent_start_us=$(( (now_secs - since_secs) * 1000000 ))
  baseline_start_us=$(( (now_secs - since_secs - baseline_secs) * 1000000 ))
  local recent_json baseline_json
  recent_json=$(oo_search_range "SELECT DISTINCT container_name FROM docker_logs" "$recent_start_us" "$now_us" 2000)
  baseline_json=$(oo_search_range "SELECT DISTINCT container_name FROM docker_logs" "$baseline_start_us" "$recent_start_us" 2000)
  python3 -c '
import json, sys
recent = json.loads(sys.argv[1])
baseline = json.loads(sys.argv[2])
if "_oo_error" in recent:
    print("error: " + recent["_oo_error"], file=sys.stderr)
    sys.exit(1)
if "_oo_error" in baseline:
    print("error: " + baseline["_oo_error"], file=sys.stderr)
    sys.exit(1)
recent_names = {h["container_name"] for h in recent.get("hits", [])}
baseline_names = {h["container_name"] for h in baseline.get("hits", [])}
new_names = sorted(recent_names - baseline_names)
if not new_names:
    print("no container names in the recent window that weren'\''t already in the baseline window", file=sys.stderr)
for n in new_names:
    print(n)
' "$recent_json" "$baseline_json"
}

cmd_check() {
  local container="${1:?usage: oo check <container_name> [--since 15m] [--host HOST]}"; shift || true
  local since="15m" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name = '${container}' AND ${ERROR_LIKE_CLAUSE}"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local result n
  result=$(oo_search "SELECT count(*) as n FROM docker_logs WHERE ${where}" "$since" 1 | python3 -c '
import json, sys
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("_ERR:" + d["_oo_error"])
    sys.exit(0)
hits = d.get("hits", [])
print(hits[0].get("n", 0) if hits else 0)
')
  # UNKNOWN (exit 2) is distinct from OK (0) / FAIL (1) on purpose: a
  # scripted `if oo check X` treats any non-zero as "not confirmed
  # healthy" either way, but a caller that cares can tell "definitely
  # has errors" apart from "couldn't even run the check" (e.g. bad
  # creds) — silently reporting OK because the request itself failed
  # would be the exact wrong default for a health check.
  if [[ "$result" == _ERR:* ]]; then
    echo "UNKNOWN: ${container} check failed to run — ${result#_ERR:}" >&2
    exit 2
  fi
  n="$result"
  if [[ "$n" -gt 0 ]]; then
    echo "FAIL: ${container} logged ${n} error-looking line(s) in the last ${since}"
    exit 1
  fi
  echo "OK: ${container} — no error-looking lines in the last ${since}"
}

cmd_save() {
  local name="${1:?usage: oo save <name> <sql>}"; shift || true
  local sql="${1:?usage: oo save <name> <sql>}"; shift || true
  mkdir -p "$OO_SAVE_DIR"
  [[ -f "$OO_SAVE_FILE" ]] || echo '{}' > "$OO_SAVE_FILE"
  # Locked, atomic read-modify-write. The pre-fix version did a bare
  # `open(path, "w"); json.dump(...)`, which truncates the file the instant
  # it's opened — two concurrent `oo save` calls (two terminals, two
  # scripted agents) interleave their writes into that same truncated
  # file and corrupt queries.json outright, not just lose one update.
  # Reproduced live 2026-08-24 (third independent review): 20 concurrent
  # `oo save` calls left the file unparseable ("Extra data" / "Expecting
  # value" JSONDecodeError), and every subsequent save/saved/run then
  # crashed with a raw traceback instead of the tool's usual clean error.
  # Fix: hold an flock(2) exclusive lock on a sibling .lock file for the
  # whole read-modify-write (serializes the critical section so no save is
  # silently lost), and write the new content to a temp file in the same
  # directory then os.replace() it into place — os.replace is an atomic
  # rename on POSIX, so even a reader that takes no lock at all (cmd_saved,
  # cmd_run) only ever sees a fully-old or fully-new file, never a torn one.
  python3 -c '
import json, sys, os, fcntl, tempfile
path, name, sql = sys.argv[1], sys.argv[2], sys.argv[3]
lock_path = path + ".lock"
with open(lock_path, "a+") as lockf:
    fcntl.flock(lockf.fileno(), fcntl.LOCK_EX)
    try:
        try:
            with open(path) as f:
                d = json.load(f)
        except (json.JSONDecodeError, FileNotFoundError) as e:
            print(f"error: {path} is missing or corrupted ({e}) — refusing to "
                  "overwrite blindly; inspect/fix it by hand, or delete it to "
                  "start fresh", file=sys.stderr)
            sys.exit(1)
        d[name] = sql
        dir_ = os.path.dirname(path) or "."
        fd, tmp = tempfile.mkstemp(dir=dir_, prefix=".queries.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(d, f, indent=2)
            os.replace(tmp, path)
        except BaseException:
            os.unlink(tmp)
            raise
    finally:
        fcntl.flock(lockf.fileno(), fcntl.LOCK_UN)
print(f"saved {name!r}")
' "$OO_SAVE_FILE" "$name" "$sql"
}

cmd_saved() {
  if [[ ! -f "$OO_SAVE_FILE" ]]; then
    echo "no saved queries yet — oo save <name> <sql>"
    return 0
  fi
  python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
except json.JSONDecodeError as e:
    print(f"error: {sys.argv[1]} is corrupted ({e})", file=sys.stderr)
    sys.exit(1)
if not d:
    print("no saved queries yet — oo save <name> <sql>")
for name, sql in d.items():
    print(f"{name}: {sql}")
' "$OO_SAVE_FILE"
}

cmd_run() {
  local name="${1:?usage: oo run <name> [--since 1h] [--limit 100] [--pretty]}"; shift || true
  local since="1h" limit="100" pretty="0"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --pretty) pretty="1"; shift ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  if [[ ! -f "$OO_SAVE_FILE" ]]; then
    echo "no saved queries yet — oo save <name> <sql>" >&2
    exit 1
  fi
  local sql
  sql=$(python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
except json.JSONDecodeError as e:
    print(f"error: {sys.argv[1]} is corrupted ({e})", file=sys.stderr)
    sys.exit(1)
name = sys.argv[2]
if name not in d:
    print(f"no saved query named {name!r} — see oo saved", file=sys.stderr)
    sys.exit(1)
print(d[name])
' "$OO_SAVE_FILE" "$name")
  require_creds
  oo_search "$sql" "$since" "$limit" | format_search_result "$pretty"
}

cmd_summary() {
  local since="1h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  echo "=== OpenObserve docker_logs summary (last ${since}) ==="
  echo
  echo "--- hosts ---"
  cmd_hosts --since "$since"
  echo
  echo "--- top 8 noisiest containers ---"
  cmd_containers --since "$since" --limit 8
  echo
  echo "--- top 8 error-containers ---"
  local sql="SELECT container_name, count(*) as n FROM docker_logs WHERE ${ERROR_LIKE_CLAUSE} GROUP BY container_name ORDER BY n DESC LIMIT 8"
  oo_search "$sql" "$since" 8 | python3 -c '
import json, sys
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
if not hits:
    print("(no error-looking lines fleet-wide)")
for h in hits:
    name = h.get("container_name", "?")
    n = h.get("n", 0)
    print(f"{name:<40} error_lines={n}")
'
}

cmd_link() {
  local sql="${1:?usage: oo link <sql> [--since 1h]}"; shift || true
  local since="1h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local secs end_us start_us
  secs=$(duration_to_seconds "$since")
  end_us=$(( $(date +%s) * 1000000 ))
  start_us=$(( end_us - secs * 1000000 ))
  echo "Web UI:     https://openobserve.0docker.com/web/logs?org_identifier=${OO_ORG}"
  echo "Query:      ${sql}"
  echo "Time range: ${start_us} .. ${end_us} (microsecond epoch — paste into the UI's custom range picker), i.e. last ${since}"
}

cmd_containers() {
  local since="1h" limit="50" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  host_filter=$(sql_escape "$host_filter")
  local where="1=1"
  [[ -n "$host_filter" ]] && where="host = '${host_filter}'"
  local sql="SELECT container_name, host, count(*) as n, max(_timestamp) as last_seen FROM docker_logs WHERE ${where} GROUP BY container_name, host ORDER BY n DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
for h in hits:
    name = h.get("container_name", "?")
    host = h.get("host", "?")
    n = h.get("n", 0)
    last = h.get("last_seen")
    last_s = datetime.datetime.fromtimestamp(last/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S") if last else "-"
    print(f"{name:<40} {host:<24} lines={n:>8}  last_seen={last_s}")
'
}

cmd_hosts() {
  local since="1h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local sql="SELECT host, count(*) as n, count(distinct container_name) as containers FROM docker_logs GROUP BY host ORDER BY n DESC"
  oo_search "$sql" "$since" 100 | python3 -c '
import json, sys
d = json.load(sys.stdin)
if "_oo_error" in d:
    print("error: " + d["_oo_error"], file=sys.stderr)
    sys.exit(1)
hits = d.get("hits", [])
for h in hits:
    host = h.get("host", "?")
    n = h.get("n", 0)
    c = h.get("containers", 0)
    print(f"{host:<24} lines={n:>10}  distinct_containers={c}")
'
}

cmd_tail() {
  local container="${1:?usage: oo tail <container_name> [--interval 3] [--host HOST]}"; shift || true
  local interval="3" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  echo "# polling tail of '${container}' every ${interval}s (Ctrl-C to stop) — re-queries a sliding window each cycle, so a line can repeat once at the boundary; for a true live stream use https://openobserve.0docker.com" >&2
  container=$(sql_escape "$container")
  host_filter=$(sql_escape "$host_filter")
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local last_printed=""
  # Cursor file uses mktemp (mode 0600, unpredictable name) rather than a
  # fixed /tmp/.oo_tail_cursor.$$ path — found live 2026-08-24 (second
  # independent review): a PID-based name in shared /tmp is guessable and
  # symlink-attackable by another local user on the same box (classic
  # TOCTOU: pre-create the path as a symlink to a file this user can
  # write, before `oo tail` starts). mktemp closes that off the same way
  # every other temp-file-needing tool should.
  local cursor_file
  cursor_file=$(mktemp "${TMPDIR:-/tmp}/oo_tail_cursor.XXXXXXXX")
  trap 'rm -f "$cursor_file"' EXIT INT TERM
  while true; do
    local sql="SELECT _timestamp, host, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT 200"
    local since_secs=$(( interval * 4 + 5 ))
    oo_search "$sql" "${since_secs}s" 200 | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
if "_oo_error" in d:
    # stdout, not stderr: this function repurposes stderr as a side
    # channel to pass the cursor timestamp back to the bash loop (see the
    # 2>"$cursor_file" redirect below) — printing the error there would
    # silently corrupt that instead of showing it. Skip this poll cycle
    # (no cursor update) rather than crash the whole tail loop, so a
    # transient blip does not lose the "resume from here" position.
    print("error (will retry next poll): " + d["_oo_error"])
    sys.exit(0)
hits = list(reversed(d.get("hits", [])))
last_printed = sys.argv[1]
skip = bool(last_printed)
for h in hits:
    key = str(h["_timestamp"])
    if skip:
        if key == last_printed:
            skip = False
        continue
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
if hits:
    print(hits[-1]["_timestamp"], file=sys.stderr, end="")
' "$last_printed" 2>"$cursor_file"
    if [[ -s "$cursor_file" ]]; then
      last_printed=$(cat "$cursor_file")
    fi
    : > "$cursor_file"
    sleep "$interval"
  done
}

cmd_streams() {
  require_creds
  ssh "$BASTION" "curl -sS --connect-timeout 10 --max-time 60 -u '${OPENOBSERVE_USER}:${OPENOBSERVE_PASSWORD}' ${BASE_URL}/api/${OO_ORG}/streams" | python3 -c '
import json, sys, datetime
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except json.JSONDecodeError:
    print("OpenObserve request failed (non-JSON response): " + raw.strip()[:300], file=sys.stderr)
    sys.exit(1)
for s in d["list"]:
    st = s["stats"]
    tmin = datetime.datetime.fromtimestamp(st["doc_time_min"]/1e6, datetime.UTC).isoformat() if st["doc_time_min"] else "-"
    tmax = datetime.datetime.fromtimestamp(st["doc_time_max"]/1e6, datetime.UTC).isoformat() if st["doc_time_max"] else "-"
    name = s["name"]
    docs = st["doc_num"]
    mb = st["compressed_size"]
    print(f"{name:<24} docs={docs:>12}  compressed_mb={mb:>10.1f}  {tmin} .. {tmax}")
'
}

cmd_stream_info() {
  local stream="${1:?usage: oo stream-info <stream_name>}"
  require_creds
  # Found live 2026-08-24 (scenario-plan review, "before writing raw SQL
  # what fields exist" scenario): the old version fetched the same
  # /streams LIST endpoint `oo streams` already uses and filtered it
  # client-side by name — but that endpoint reports total_fields: 0 and
  # empty settings.index_fields/full_text_search_keys for a
  # dynamic-schema stream like docker_logs, so it never actually told
  # the caller what fields exist. OpenObserve has a dedicated
  # /streams/{name}/schema endpoint that returns the real
  # [{name,type}, ...] field list (confirmed live: 43 fields for
  # docker_logs, including container_name/host/message/image) — use
  # that instead.
  #
  # $stream goes into the URL path this time, which (unlike every other
  # user-controlled value in this file) has no argv-passing indirection
  # available — curl needs it in the URL it is given on the bastion's
  # command line, and that command line is built as a bash
  # DOUBLE-quoted string handed to ssh, so anything containing
  # backticks/$(...) would be shell-expanded before curl ever saw it
  # (the exact class of bug the old code above was already careful to
  # avoid for the *python* side). Close it off the same way sql_escape
  # closes off SQL injection elsewhere: validate against a strict
  # allowlist charset before it ever reaches the ssh command string. A
  # real OpenObserve stream name is always [A-Za-z0-9_], never anything
  # that could break out of the quoting.
  if [[ ! "$stream" =~ ^[A-Za-z0-9_]+$ ]]; then
    echo "error: invalid stream name '${stream}' (expected letters/digits/underscore only)" >&2
    exit 1
  fi
  ssh "$BASTION" "curl -sS --connect-timeout 10 --max-time 60 -u '${OPENOBSERVE_USER}:${OPENOBSERVE_PASSWORD}' ${BASE_URL}/api/${OO_ORG}/streams/${stream}/schema" | python3 -c '
import json, sys
raw = sys.stdin.read()
stream = sys.argv[1]
try:
    d = json.loads(raw)
except json.JSONDecodeError:
    print("OpenObserve request failed (non-JSON response): " + raw.strip()[:300], file=sys.stderr)
    sys.exit(1)
if "schema" not in d:
    print("stream not found: " + stream + " (" + json.dumps(d)[:300] + ")", file=sys.stderr)
    sys.exit(1)
print(json.dumps(d, indent=2))
' "$stream"
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    query) cmd_query "$@" ;;
    logs) cmd_logs "$@" ;;
    grep) cmd_grep "$@" ;;
    errors) cmd_errors "$@" ;;
    since-redeploy) cmd_since_redeploy "$@" ;;
    context) cmd_context "$@" ;;
    compare) cmd_compare "$@" ;;
    restarts) cmd_restarts "$@" ;;
    rate) cmd_rate "$@" ;;
    versions) cmd_versions "$@" ;;
    new) cmd_new "$@" ;;
    check) cmd_check "$@" ;;
    save) cmd_save "$@" ;;
    saved) cmd_saved "$@" ;;
    run) cmd_run "$@" ;;
    summary) cmd_summary "$@" ;;
    link) cmd_link "$@" ;;
    containers) cmd_containers "$@" ;;
    hosts) cmd_hosts "$@" ;;
    tail) cmd_tail "$@" ;;
    streams) cmd_streams "$@" ;;
    stream-info) cmd_stream_info "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage >&2; exit 1 ;;
  esac
}

main "$@"
