#!/usr/bin/env bash
# bin/oo — deterministic CLI for the fleet's OpenObserve instance (LXC 106).
#
# WHY this exists: 2026-08-23 incident response needed "what did this
# container print before it got redeployed" — `docker logs` only shows the
# CURRENT container instance's output, so a redeploy silently loses
# history. Every docker host now runs a Vector shipper
# (/opt/observability/vector-log-shipper/ on each host) that forwards
# every container's stdout/stderr into OpenObserve's `docker_logs` stream,
# tagged with container_name/host/image/compose labels — independent of
# container lifecycle. This script is the deterministic way to query it,
# so nobody has to hand-roll curl + inline python timestamp math again.
#
# All requests are proxied through the bastion via SSH — OpenObserve's
# LAN address (see fleet-state/OPS.md) is only reachable from inside
# the 0docker.com private LAN, not from an operator's workstation
# directly.
#
# USAGE:
#   oo query <sql> [--since DURATION] [--limit N] [--org ORG]
#       Run an arbitrary SQL query against a stream (default org "default").
#       The stream name goes in the SQL's FROM clause, e.g.
#       'SELECT * FROM docker_logs WHERE ...'.
#
#   oo logs <container_name> [--since DURATION] [--grep PATTERN] [--limit N] [--host HOST]
#       Convenience wrapper: every log line for one container, newest
#       first. --grep does a substring match on the message field.
#       --host disambiguates if the same container name exists on more
#       than one docker host (rare, but container names aren't globally
#       unique across the fleet).
#
#   oo grep <pattern> [--since DURATION] [--container NAME] [--host HOST] [--limit N]
#       Full-text search across EVERY container fleet-wide (not just one
#       you already know the name of) — the actual "grep the fleet"
#       capability. Scope with --container / --host if you already know
#       where to look; omit both to search everywhere.
#
#   oo errors [container_name] [--since DURATION] [--host HOST] [--limit N]
#       Shortcut for the #1 incident-response query: lines whose message
#       looks like an error (case-insensitive match on error/fatal/
#       panic, excluding the "error":null / error=<nil> false positives
#       this fleet's own logging idioms produce — see ERROR_LIKE_CLAUSE).
#       Omit container_name to scan the whole fleet.
#
#   oo since-redeploy <container_name> [--host HOST] [--window DURATION] [--before DURATION] [--after DURATION] [--limit N]
#       THE command this tool exists for: finds the earliest log line
#       for the container's CURRENT instance within the lookback
#       --window (default 24h — widen it if the container has been up
#       longer than that and this comes back empty), then shows
#       everything from --before that point through --after it
#       (defaults 5m / 10m). That's the exact "what happened right when
#       this thing (re)started" view that redeploying blind loses.
#       Approximate, not exact: it's the earliest line seen in the
#       window, not a real process-start timestamp — good enough for
#       "did this come up clean" in practice.
#
#   oo containers [--since DURATION] [--host HOST] [--limit N]
#       Discover what's actually logging: container_name + host, line
#       count, and last-seen time, sorted noisiest-first. Answers "what
#       containers exist" and "what's chatty" in one shot.
#
#   oo hosts [--since DURATION]
#       Which docker hosts are shipping to docker_logs, with line count
#       and distinct-container count per host. Sanity-check after adding
#       a new host's vector-log-shipper.
#
#   oo context <container_name> <timestamp> [--before DURATION] [--after DURATION] [--host HOST] [--limit N]
#       Generalizes since-redeploy's window logic to any point in time,
#       not just a container's start: given a timestamp you already
#       found interesting (epoch seconds or ISO8601), show what else
#       that container logged right around it. --before/--after default
#       2m/2m.
#
#   oo compare <container1> <container2> [--since DURATION] [--limit N]
#       Interleave two containers' log lines in one timestamp-ordered
#       stream, each tagged <name>. For correlating a request across
#       two services (api + its proxy, prod + staging, etc).
#
#   oo restarts <container_name> [--since DURATION] [--gap DURATION] [--host HOST]
#       Infers apparent restarts by finding gaps larger than --gap
#       (default 30s) in the container's log timeline within --since
#       (default 24h) — no docker inspect / SSH-to-host needed. A real
#       gap means either a crash/restart or a genuinely quiet period;
#       cross-check with --gap tuned to the container's normal chattiness.
#
#   oo rate <container_name> [--since DURATION] [--bucket DURATION] [--host HOST]
#       Lines-per-bucket histogram (default: 1h window, 5m buckets) —
#       spot volume spikes or drops at a glance without hand-writing a
#       GROUP BY.
#
#   oo versions <container_name> [--since DURATION] [--host HOST]
#       Distinct `image` values seen for a container, each with
#       first/last-seen and line count — an image tag change is a
#       deploy; this is deploy history without touching git or GHCR.
#
#   oo new [--since DURATION] [--baseline DURATION]
#       container_names seen in the last --since (default 1h) that were
#       NOT seen in the --baseline period before that (default 24h) —
#       flags unexpected churn: a container that just started existing.
#
#   oo check <container_name> [--since DURATION] [--host HOST]
#       Scriptable health check: exit 0 + "OK" if no error-looking lines
#       in --since (default 15m), exit 1 + "FAIL" (with count) otherwise.
#       Built for `if oo check X; then …`, not for reading — no
#       pretty-printing, one line of output.
#
#   oo save <name> <sql>
#   oo saved
#   oo run <name> [--since DURATION] [--limit N]
#       Bookmark a query once (locally, in ~/.oo/queries.json — never
#       synced or committed), list what's saved, re-run one by name
#       instead of retyping SQL every session.
#
#   oo summary [--since DURATION]
#       One-shot fleet orientation: host breakdown, top 8 noisiest
#       containers, top 8 error-containers. Start an investigation here
#       instead of four separate round trips.
#
#   oo link <sql> [--since DURATION]
#       Prints the web UI URL plus the query and resolved time range as
#       copy-paste text, for handing a query off to a human instead of
#       (or in addition to) reading the CLI output yourself.
#
#   oo tail <container_name> [--interval SECONDS] [--host HOST]
#       Polling tail (default 3s interval) — not a true push/websocket
#       stream. Good enough for "watch this thing after I redeploy it";
#       for a real live-tail UI, use https://openobserve.0docker.com
#       directly (ZO_WEBSOCKET_ENABLED is on).
#
#   oo streams
#       List every stream in the org with doc count / time range / size.
#
# DURATION: Ns / Nm / Nh / Nd (default: 1h). Examples: 30s, 15m, 2h, 3d.
#
# ENV (required): OPENOBSERVE_USER, OPENOBSERVE_PASSWORD, OPENOBSERVE_HOST
#   — see bin/fleet-runner.env.example. Real values live in
#   fleet-state/OPS.md (private) — never hardcode them here, this repo
#   is public.
# ENV (optional): FLEET_BASTION (default root@0docker.com),
#   OPENOBSERVE_PORT (default 5080), OO_SAVE_DIR (default ~/.oo — where
#   `oo save`/`oo run` keep bookmarked queries, local to your machine).
#
# Known limitation: credentials are passed to curl via -u on the bastion's
# command line, so they're briefly visible in that host's `ps aux` output
# during the request — acceptable for this internal, bastion-only admin
# path (same pattern used ad hoc throughout the 2026-08-23 incident), but
# don't reuse this pattern for anything internet-facing.

set -euo pipefail

BASTION="${FLEET_BASTION:-root@0docker.com}"
OO_HOST="${OPENOBSERVE_HOST:-}"
OO_PORT="${OPENOBSERVE_PORT:-5080}"
OO_ORG="${OPENOBSERVE_ORG:-default}"
OO_SAVE_DIR="${OO_SAVE_DIR:-$HOME/.oo}"
OO_SAVE_FILE="${OO_SAVE_DIR}/queries.json"

# Heuristic "this line looks like an error" match, shared by errors/check/
# summary. Tuned twice against REAL fleet data (2026-08-23), not just
# domainscope-api:
#
#   Excludes (false positives found by sampling matches across the top
#   error-count containers fleet-wide, not just the one that motivated
#   the tool):
#     - "error":null / error=<nil> / error: <nil> — this fleet's own
#       structured-logging idiom for "no error occurred" (JSON and Go
#       logfmt both literally contain the substring "error" even when
#       stating its absence). domainscope-api alone was ~80%
#       false-positive on the naive version before this exclusion.
#     - state=Error — Grafana's alerting engine uses "Error" as one
#       enum value of an alert's evaluation state; "Detected stale
#       state entry ... state=Error" is routine INFO-level cache
#       housekeeping, not an active problem. 46% of go-fleet-grafana's
#       naive matches were this one shape.
#
#   Adds (false negatives found by grep-ing for other common failure
#   words NOT already covered, then sampling the matches to check they
#   were genuine — "failed to" and "crash" were tried and REJECTED here
#   because they matched high-volume benign noise instead: "failed to"
#   is dominated by a benign `DEBUG: Failed to open service.yaml`
#   boilerplate line shared by dozens of pentest-tool containers on
#   startup, and "crash" matched a proxied page's URL containing the
#   word as part of a GitHub repo name, not an actual crash):
#     - refused — real ECONNREFUSED monitor-down alerts from
#       0init-uptime-kuma, a single clean source with zero observed
#       false positives in this sample.
#
# Not exhaustive — a log shape nobody's tested against yet could still
# slip through in either direction; re-validate the same way (sample
# top containers under `errors`/`summary`, grep for un-covered failure
# words, check volume + a real sample before adding/excluding anything)
# rather than guessing.
ERROR_LIKE_CLAUSE="(message ILIKE '%error%' OR message ILIKE '%fatal%' OR message ILIKE '%panic%' OR message ILIKE '%refused%') AND message NOT ILIKE '%\"error\":null%' AND message NOT ILIKE '%error=<nil>%' AND message NOT ILIKE '%error: <nil>%' AND message NOT ILIKE '%state=Error%'"

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

require_creds() {
  : "${OPENOBSERVE_USER:?OPENOBSERVE_USER is not set — see bin/fleet-runner.env.example}"
  : "${OPENOBSERVE_PASSWORD:?OPENOBSERVE_PASSWORD is not set — see bin/fleet-runner.env.example}"
  : "${OO_HOST:?OPENOBSERVE_HOST is not set — see bin/fleet-runner.env.example / fleet-state/OPS.md}"
  BASE_URL="http://${OO_HOST}:${OO_PORT}"
}

duration_to_seconds() {
  local d="$1" num unit
  unit="${d: -1}"
  num="${d%[smhd]}"
  if ! [[ "$num" =~ ^[0-9]+$ ]]; then
    echo "invalid duration: $d (use Ns/Nm/Nh/Nd, e.g. 30s, 15m, 2h, 3d)" >&2
    exit 1
  fi
  case "$unit" in
    s) echo "$num" ;;
    m) echo $((num * 60)) ;;
    h) echo $((num * 3600)) ;;
    d) echo $((num * 86400)) ;;
    *) echo "invalid duration: $d (use Ns/Nm/Nh/Nd, e.g. 30s, 15m, 2h, 3d)" >&2; exit 1 ;;
  esac
}

# oo_search_range SQL START_US END_US LIMIT — the primitive: an absolute
# microsecond-epoch time range.
oo_search_range() {
  local sql="$1" start_us="$2" end_us="$3" limit="$4"
  local payload
  payload=$(python3 -c '
import json, sys
sql, start, end, size = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
print(json.dumps({"query": {"sql": sql, "start_time": start, "end_time": end, "size": size}}))
' "$sql" "$start_us" "$end_us" "$limit")
  ssh "$BASTION" "curl -sS -u '${OPENOBSERVE_USER}:${OPENOBSERVE_PASSWORD}' -X POST ${BASE_URL}/api/${OO_ORG}/_search -H 'Content-Type: application/json' --data-binary @-" <<<"$payload"
}

# oo_search SQL SINCE_DURATION LIMIT — the common case: relative to now.
oo_search() {
  local sql="$1" since="$2" limit="$3"
  local end_us start_us secs
  secs=$(duration_to_seconds "$since")
  end_us=$(( $(date +%s) * 1000000 ))
  start_us=$(( end_us - secs * 1000000 ))
  oo_search_range "$sql" "$start_us" "$end_us" "$limit"
}

cmd_query() {
  local sql="${1:?usage: oo query <sql> [--since 1h] [--limit 100]}"; shift || true
  local since="1h" limit="100"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  oo_search "$sql" "$since" "$limit" | python3 -m json.tool
}

cmd_logs() {
  local container="${1:?usage: oo logs <container_name> [--since 1h] [--grep pattern] [--limit 100] [--host HOST]}"; shift || true
  local since="1h" limit="100" grep_pat="" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --grep) grep_pat="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  [[ -n "$grep_pat" ]] && where="${where} AND message LIKE '%${grep_pat}%'"
  local sql="SELECT _timestamp, host, container_name, stream, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("(no matching log lines — check --since / --host / container name)", file=sys.stderr)
for h in reversed(hits):
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
'
}

cmd_grep() {
  local pattern="${1:?usage: oo grep <pattern> [--since 1h] [--container NAME] [--host HOST] [--limit 100]}"; shift || true
  local since="1h" limit="100" container_filter="" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --container) container_filter="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="message LIKE '%${pattern}%'"
  [[ -n "$container_filter" ]] && where="${where} AND container_name = '${container_filter}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local sql="SELECT _timestamp, host, container_name, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("(no matches — check --since / --container / --host / pattern)", file=sys.stderr)
for h in reversed(hits):
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    name = h.get("container_name", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}/{name}] {msg}")
'
}

cmd_errors() {
  local container="" since="1h" limit="100" host_filter=""
  if [[ $# -gt 0 && "${1:0:2}" != "--" ]]; then
    container="$1"; shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="${ERROR_LIKE_CLAUSE}"
  [[ -n "$container" ]] && where="${where} AND container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local sql="SELECT _timestamp, host, container_name, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("(no error-looking lines — check --since / container / --host)", file=sys.stderr)
for h in reversed(hits):
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    name = h.get("container_name", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}/{name}] {msg}")
'
}

cmd_since_redeploy() {
  local container="${1:?usage: oo since-redeploy <container_name> [--host HOST] [--window 24h] [--before 5m] [--after 10m] [--limit 500]}"; shift || true
  local window="24h" before="5m" after="10m" limit="500" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host_filter="$2"; shift 2 ;;
      --window) window="$2"; shift 2 ;;
      --before) before="$2"; shift 2 ;;
      --after) after="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"

  echo "# finding the earliest log line for '${container}' in the last ${window} (approximates its current instance's start — widen --window if it's been up longer than that)" >&2
  local first_seen
  first_seen=$(oo_search "SELECT min(_timestamp) as first_seen FROM docker_logs WHERE ${where}" "$window" 1 | python3 -c '
import json, sys
d = json.load(sys.stdin)
hits = d.get("hits", [])
fs = hits[0].get("first_seen") if hits else None
print(fs if fs is not None else "")
')
  if [[ -z "$first_seen" ]]; then
    echo "no log lines found for '${container}' in the last ${window} — check the container name / --host, or widen --window" >&2
    exit 1
  fi

  local first_seen_human before_secs after_secs first_secs now_secs start_us end_us
  first_seen_human=$(python3 -c "import datetime; print(datetime.datetime.fromtimestamp(${first_seen}/1e6, datetime.UTC).isoformat())")
  echo "# earliest line found at ${first_seen_human} UTC — showing --before ${before} through --after ${after} around it" >&2
  before_secs=$(duration_to_seconds "$before")
  after_secs=$(duration_to_seconds "$after")
  first_secs=$(( first_seen / 1000000 ))
  now_secs=$(date +%s)
  start_us=$(( (first_secs - before_secs) * 1000000 ))
  end_us=$(( (first_secs + after_secs) * 1000000 ))
  (( end_us > now_secs * 1000000 )) && end_us=$(( now_secs * 1000000 ))

  local sql="SELECT _timestamp, host, message FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search_range "$sql" "$start_us" "$end_us" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("(no log lines in that window)", file=sys.stderr)
for h in hits:
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
'
}

cmd_context() {
  local container="${1:?usage: oo context <container_name> <timestamp> [--before 2m] [--after 2m] [--host HOST] [--limit 500]}"; shift || true
  local ts="${1:?usage: oo context <container_name> <timestamp> [--before 2m] [--after 2m] [--host HOST] [--limit 500]}"; shift || true
  local before="2m" after="2m" host_filter="" limit="500"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --before) before="$2"; shift 2 ;;
      --after) after="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"

  local center_secs
  center_secs=$(python3 -c '
import sys, datetime
v = sys.argv[1]
try:
    print(int(v))
except ValueError:
    try:
        dt = datetime.datetime.fromisoformat(v.replace("Z", "+00:00"))
        print(int(dt.timestamp()))
    except Exception:
        print(f"invalid timestamp: {v} (use epoch seconds or ISO8601)", file=sys.stderr)
        sys.exit(1)
' "$ts")

  local before_secs after_secs start_us end_us now_us
  before_secs=$(duration_to_seconds "$before")
  after_secs=$(duration_to_seconds "$after")
  start_us=$(( (center_secs - before_secs) * 1000000 ))
  end_us=$(( (center_secs + after_secs) * 1000000 ))
  now_us=$(( $(date +%s) * 1000000 ))
  (( end_us > now_us )) && end_us=$now_us

  local sql="SELECT _timestamp, host, message FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search_range "$sql" "$start_us" "$end_us" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("(no log lines in that window)", file=sys.stderr)
for h in hits:
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
'
}

cmd_compare() {
  local c1="${1:?usage: oo compare <container1> <container2> [--since 15m] [--limit 100]}"; shift || true
  local c2="${1:?usage: oo compare <container1> <container2> [--since 15m] [--limit 100]}"; shift || true
  local since="15m" limit="100"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local sql="SELECT _timestamp, host, container_name, message FROM docker_logs WHERE container_name IN ('${c1}', '${c2}') ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("(no matching log lines)", file=sys.stderr)
for h in hits:
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    name = h.get("container_name", "?")
    msg = h.get("message", "")
    print(f"{ts} <{name}> {msg}")
'
}

cmd_restarts() {
  local container="${1:?usage: oo restarts <container_name> [--since 24h] [--gap 30s] [--host HOST] [--limit 5000]}"; shift || true
  local since="24h" gap="30s" host_filter="" limit="5000"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --gap) gap="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local gap_secs
  gap_secs=$(duration_to_seconds "$gap")
  local sql="SELECT _timestamp FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
gap_secs = int(sys.argv[1])
container = sys.argv[2]
since_label = sys.argv[3]
gap_us = gap_secs * 1000000
if len(hits) < 2:
    print("not enough data to detect gaps (need >=2 lines) — check --since / --host / container name", file=sys.stderr)
    sys.exit(0)
prev = hits[0]["_timestamp"]
found = 0
for h in hits[1:]:
    cur = h["_timestamp"]
    if cur - prev > gap_us:
        gap_s = (cur - prev) / 1e6
        t1 = datetime.datetime.fromtimestamp(prev/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
        t2 = datetime.datetime.fromtimestamp(cur/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
        print(f"gap of {gap_s:.0f}s: {t1} .. {t2} UTC (likely restart or quiet period)")
        found += 1
    prev = cur
if found == 0:
    print(f"no gaps > {gap_secs}s found in the last {since_label} — {container} looks continuously up")
' "$gap_secs" "$container" "$since"
}

cmd_rate() {
  local container="${1:?usage: oo rate <container_name> [--since 1h] [--bucket 5m] [--host HOST] [--limit 10000]}"; shift || true
  local since="1h" bucket="5m" host_filter="" limit="10000"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --bucket) bucket="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local bucket_secs
  bucket_secs=$(duration_to_seconds "$bucket")
  local sql="SELECT _timestamp FROM docker_logs WHERE ${where} ORDER BY _timestamp ASC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime, collections
d = json.load(sys.stdin)
hits = d.get("hits", [])
bucket_us = int(sys.argv[1]) * 1000000
if not hits:
    print("no data in window — check --since / --host / container name", file=sys.stderr)
    sys.exit(0)
counts = collections.Counter()
for h in hits:
    counts[h["_timestamp"] // bucket_us] += 1
maxc = max(counts.values())
for k in sorted(counts):
    t = datetime.datetime.fromtimestamp(k * bucket_us / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M")
    n = counts[k]
    bar = "#" * max(1, int(n / maxc * 40))
    print(f"{t}  {n:>6}  {bar}")
' "$bucket_secs"
}

cmd_versions() {
  local container="${1:?usage: oo versions <container_name> [--since 7d] [--host HOST]}"; shift || true
  local since="7d" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local sql="SELECT image, min(_timestamp) as first_seen, max(_timestamp) as last_seen, count(*) as n FROM docker_logs WHERE ${where} GROUP BY image ORDER BY last_seen DESC"
  oo_search "$sql" "$since" 100 | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("no data — check container name / --since / --host", file=sys.stderr)
for h in hits:
    img = h.get("image", "?")
    fs = datetime.datetime.fromtimestamp(h["first_seen"]/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
    ls = datetime.datetime.fromtimestamp(h["last_seen"]/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S")
    n = h.get("n", 0)
    print(f"{img}\n  first_seen={fs}  last_seen={ls}  lines={n}")
'
}

cmd_new() {
  local since="1h" baseline="24h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --baseline) baseline="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local since_secs baseline_secs now_secs now_us recent_start_us baseline_start_us
  since_secs=$(duration_to_seconds "$since")
  baseline_secs=$(duration_to_seconds "$baseline")
  now_secs=$(date +%s)
  now_us=$(( now_secs * 1000000 ))
  recent_start_us=$(( (now_secs - since_secs) * 1000000 ))
  baseline_start_us=$(( (now_secs - since_secs - baseline_secs) * 1000000 ))
  local recent_json baseline_json
  recent_json=$(oo_search_range "SELECT DISTINCT container_name FROM docker_logs" "$recent_start_us" "$now_us" 2000)
  baseline_json=$(oo_search_range "SELECT DISTINCT container_name FROM docker_logs" "$baseline_start_us" "$recent_start_us" 2000)
  python3 -c '
import json, sys
recent = json.loads(sys.argv[1])
baseline = json.loads(sys.argv[2])
recent_names = {h["container_name"] for h in recent.get("hits", [])}
baseline_names = {h["container_name"] for h in baseline.get("hits", [])}
new_names = sorted(recent_names - baseline_names)
if not new_names:
    print("no container names in the recent window that weren'\''t already in the baseline window", file=sys.stderr)
for n in new_names:
    print(n)
' "$recent_json" "$baseline_json"
}

cmd_check() {
  local container="${1:?usage: oo check <container_name> [--since 15m] [--host HOST]}"; shift || true
  local since="15m" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="container_name = '${container}' AND ${ERROR_LIKE_CLAUSE}"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local n
  n=$(oo_search "SELECT count(*) as n FROM docker_logs WHERE ${where}" "$since" 1 | python3 -c '
import json, sys
d = json.load(sys.stdin)
hits = d.get("hits", [])
print(hits[0].get("n", 0) if hits else 0)
')
  if [[ "$n" -gt 0 ]]; then
    echo "FAIL: ${container} logged ${n} error-looking line(s) in the last ${since}"
    exit 1
  fi
  echo "OK: ${container} — no error-looking lines in the last ${since}"
}

cmd_save() {
  local name="${1:?usage: oo save <name> <sql>}"; shift || true
  local sql="${1:?usage: oo save <name> <sql>}"; shift || true
  mkdir -p "$OO_SAVE_DIR"
  [[ -f "$OO_SAVE_FILE" ]] || echo '{}' > "$OO_SAVE_FILE"
  python3 -c '
import json, sys
path, name, sql = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    d = json.load(f)
d[name] = sql
with open(path, "w") as f:
    json.dump(d, f, indent=2)
print(f"saved {name!r}")
' "$OO_SAVE_FILE" "$name" "$sql"
}

cmd_saved() {
  if [[ ! -f "$OO_SAVE_FILE" ]]; then
    echo "no saved queries yet — oo save <name> <sql>"
    return 0
  fi
  python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    d = json.load(f)
if not d:
    print("no saved queries yet — oo save <name> <sql>")
for name, sql in d.items():
    print(f"{name}: {sql}")
' "$OO_SAVE_FILE"
}

cmd_run() {
  local name="${1:?usage: oo run <name> [--since 1h] [--limit 100]}"; shift || true
  local since="1h" limit="100"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  if [[ ! -f "$OO_SAVE_FILE" ]]; then
    echo "no saved queries yet — oo save <name> <sql>" >&2
    exit 1
  fi
  local sql
  sql=$(python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    d = json.load(f)
name = sys.argv[2]
if name not in d:
    print(f"no saved query named {name!r} — see oo saved", file=sys.stderr)
    sys.exit(1)
print(d[name])
' "$OO_SAVE_FILE" "$name")
  require_creds
  oo_search "$sql" "$since" "$limit" | python3 -m json.tool
}

cmd_summary() {
  local since="1h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  echo "=== OpenObserve docker_logs summary (last ${since}) ==="
  echo
  echo "--- hosts ---"
  cmd_hosts --since "$since"
  echo
  echo "--- top 8 noisiest containers ---"
  cmd_containers --since "$since" --limit 8
  echo
  echo "--- top 8 error-containers ---"
  local sql="SELECT container_name, count(*) as n FROM docker_logs WHERE ${ERROR_LIKE_CLAUSE} GROUP BY container_name ORDER BY n DESC LIMIT 8"
  oo_search "$sql" "$since" 8 | python3 -c '
import json, sys
d = json.load(sys.stdin)
hits = d.get("hits", [])
if not hits:
    print("(no error-looking lines fleet-wide)")
for h in hits:
    name = h.get("container_name", "?")
    n = h.get("n", 0)
    print(f"{name:<40} error_lines={n}")
'
}

cmd_link() {
  local sql="${1:?usage: oo link <sql> [--since 1h]}"; shift || true
  local since="1h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local secs end_us start_us
  secs=$(duration_to_seconds "$since")
  end_us=$(( $(date +%s) * 1000000 ))
  start_us=$(( end_us - secs * 1000000 ))
  echo "Web UI:     https://openobserve.0docker.com/web/logs?org_identifier=${OO_ORG}"
  echo "Query:      ${sql}"
  echo "Time range: ${start_us} .. ${end_us} (microsecond epoch — paste into the UI's custom range picker), i.e. last ${since}"
}

cmd_containers() {
  local since="1h" limit="50" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local where="1=1"
  [[ -n "$host_filter" ]] && where="host = '${host_filter}'"
  local sql="SELECT container_name, host, count(*) as n, max(_timestamp) as last_seen FROM docker_logs WHERE ${where} GROUP BY container_name, host ORDER BY n DESC LIMIT ${limit}"
  oo_search "$sql" "$since" "$limit" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = d.get("hits", [])
for h in hits:
    name = h.get("container_name", "?")
    host = h.get("host", "?")
    n = h.get("n", 0)
    last = h.get("last_seen")
    last_s = datetime.datetime.fromtimestamp(last/1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S") if last else "-"
    print(f"{name:<40} {host:<24} lines={n:>8}  last_seen={last_s}")
'
}

cmd_hosts() {
  local since="1h"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  local sql="SELECT host, count(*) as n, count(distinct container_name) as containers FROM docker_logs GROUP BY host ORDER BY n DESC"
  oo_search "$sql" "$since" 100 | python3 -c '
import json, sys
d = json.load(sys.stdin)
hits = d.get("hits", [])
for h in hits:
    host = h.get("host", "?")
    n = h.get("n", 0)
    c = h.get("containers", 0)
    print(f"{host:<24} lines={n:>10}  distinct_containers={c}")
'
}

cmd_tail() {
  local container="${1:?usage: oo tail <container_name> [--interval 3] [--host HOST]}"; shift || true
  local interval="3" host_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="$2"; shift 2 ;;
      --host) host_filter="$2"; shift 2 ;;
      *) echo "unknown flag: $1" >&2; exit 1 ;;
    esac
  done
  require_creds
  echo "# polling tail of '${container}' every ${interval}s (Ctrl-C to stop) — re-queries a sliding window each cycle, so a line can repeat once at the boundary; for a true live stream use https://openobserve.0docker.com" >&2
  local where="container_name = '${container}'"
  [[ -n "$host_filter" ]] && where="${where} AND host = '${host_filter}'"
  local last_printed=""
  while true; do
    local sql="SELECT _timestamp, host, message FROM docker_logs WHERE ${where} ORDER BY _timestamp DESC LIMIT 200"
    local since_secs=$(( interval * 4 + 5 ))
    oo_search "$sql" "${since_secs}s" 200 | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
hits = list(reversed(d.get("hits", [])))
last_printed = sys.argv[1]
skip = bool(last_printed)
for h in hits:
    key = str(h["_timestamp"])
    if skip:
        if key == last_printed:
            skip = False
        continue
    ts = datetime.datetime.fromtimestamp(h["_timestamp"] / 1e6, datetime.UTC).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    host = h.get("host", "?")
    msg = h.get("message", "")
    print(f"{ts} [{host}] {msg}")
if hits:
    print(hits[-1]["_timestamp"], file=sys.stderr, end="")
' "$last_printed" 2>/tmp/.oo_tail_cursor.$$
    if [[ -s /tmp/.oo_tail_cursor.$$ ]]; then
      last_printed=$(cat /tmp/.oo_tail_cursor.$$)
    fi
    rm -f /tmp/.oo_tail_cursor.$$
    sleep "$interval"
  done
}

cmd_streams() {
  require_creds
  ssh "$BASTION" "curl -sS -u '${OPENOBSERVE_USER}:${OPENOBSERVE_PASSWORD}' ${BASE_URL}/api/${OO_ORG}/streams" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
for s in d["list"]:
    st = s["stats"]
    tmin = datetime.datetime.fromtimestamp(st["doc_time_min"]/1e6, datetime.UTC).isoformat() if st["doc_time_min"] else "-"
    tmax = datetime.datetime.fromtimestamp(st["doc_time_max"]/1e6, datetime.UTC).isoformat() if st["doc_time_max"] else "-"
    name = s["name"]
    docs = st["doc_num"]
    mb = st["compressed_size"]
    print(f"{name:<24} docs={docs:>12}  compressed_mb={mb:>10.1f}  {tmin} .. {tmax}")
'
}

cmd_stream_info() {
  local stream="${1:?usage: oo stream-info <stream_name>}"
  require_creds
  ssh "$BASTION" "curl -sS -u '${OPENOBSERVE_USER}:${OPENOBSERVE_PASSWORD}' ${BASE_URL}/api/${OO_ORG}/streams" | python3 -c "
import json, sys
d = json.load(sys.stdin)
for s in d['list']:
    if s['name'] == '${stream}':
        print(json.dumps(s, indent=2))
        break
else:
    print('stream not found: ${stream}', file=sys.stderr)
    sys.exit(1)
"
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    query) cmd_query "$@" ;;
    logs) cmd_logs "$@" ;;
    grep) cmd_grep "$@" ;;
    errors) cmd_errors "$@" ;;
    since-redeploy) cmd_since_redeploy "$@" ;;
    context) cmd_context "$@" ;;
    compare) cmd_compare "$@" ;;
    restarts) cmd_restarts "$@" ;;
    rate) cmd_rate "$@" ;;
    versions) cmd_versions "$@" ;;
    new) cmd_new "$@" ;;
    check) cmd_check "$@" ;;
    save) cmd_save "$@" ;;
    saved) cmd_saved "$@" ;;
    run) cmd_run "$@" ;;
    summary) cmd_summary "$@" ;;
    link) cmd_link "$@" ;;
    containers) cmd_containers "$@" ;;
    hosts) cmd_hosts "$@" ;;
    tail) cmd_tail "$@" ;;
    streams) cmd_streams "$@" ;;
    stream-info) cmd_stream_info "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage >&2; exit 1 ;;
  esac
}

main "$@"
