[Unit]
Description=Weekly fleet secret scan (gitleaks over every repo's origin/main)
Documentation=https://github.com/baditaflorin/services-registry/blob/main/bin/secret-scan.deploy/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
StateDirectory=secret-scan
# About 55 minutes on a busy builder (one repo at a time, nice 15, 768 MB per container).
TimeoutStartSec=3h
Nice=15
IOSchedulingClass=idle
ExecStart=/usr/local/bin/secret-scan-weekly
