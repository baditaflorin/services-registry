# Environment for templates/woodpecker-agent-ci-cache.override.yml.
# Copy the lines you need into the agent's .env. None of these is a secret.

# Host directory that holds the shared caches (go-build, go-mod, npm).
# Put it on the disk with the most free space; scripts/ci-cache/install-host.sh
# refuses to continue if less than CI_CACHE_MIN_FREE_GB is free there.
WOODPECKER_CI_CACHE_ROOT=/var/cache/woodpecker-ci

# Read by scripts/ci-cache/install-host.sh and scripts/ci-cache/prune.sh only.
CI_CACHE_MIN_FREE_GB=40
CI_CACHE_GO_BUILD_MAX_GB=8
CI_CACHE_GO_MOD_MAX_GB=6
CI_CACHE_NPM_MAX_GB=3
