{
  "version": 2,
  "woodpecker_url": "https://ci.example.com",
  "interval_seconds": 30,
  "minimum_schedulable_nodes": 1,
  "stop_samples": 10,
  "resume_samples": 20,
  "thresholds": {
    "cpu_stop_pct": 85,
    "cpu_resume_pct": 60,
    "memory_stop_pct": 15,
    "memory_resume_pct": 30,
    "disk_stop_pct": 10,
    "disk_resume_pct": 15
  },
  "nodes": [
    {
      "name": "builder-a",
      "agent_names": ["builder-a-agent-1", "builder-a-agent-2"],
      "metrics_url": "http://builder-a.example.internal:9100/metrics",
      "filesystem_mountpoint": "/"
    },
    {
      "name": "builder-b",
      "agent_names": ["builder-b-agent"],
      "metrics_url": "http://builder-b.example.internal:9100/metrics",
      "filesystem_mountpoint": "/"
    }
  ]
}
