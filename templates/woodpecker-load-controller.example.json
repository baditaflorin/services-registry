{
  "version": 2,
  "woodpecker_url": "https://ci.example.com",
  "interval_seconds": 30,
  "minimum_schedulable_nodes": 1,
  "stop_samples": 10,
  "resume_samples": 20,
  "thresholds": {
    "cpu_stop_pct": 85,
    "cpu_resume_pct": 60,
    "memory_stop_pct": 15,
    "memory_resume_pct": 30,
    "disk_stop_pct": 10,
    "disk_resume_pct": 15
  },
  "nodes": [
    {
      "name": "builder-a",
      "agent_names": [
        "builder-a-agent-1",
        "builder-a-agent-2"
      ],
      "metrics_url": "http://builder-a.example.internal:9100/metrics",
      "filesystem_mountpoint": "/",
      "backing_storage": {
        "metrics_url": "http://hypervisor.example.internal:9100/metrics",
        "filesystem_mountpoint": "/",
        "filesystem_device": "/dev/md3",
        "disk_stop_pct": 10,
        "disk_resume_pct": 15,
        "minimum_free_bytes": 53687091200
      }
    },
    {
      "name": "builder-b",
      "agent_names": [
        "builder-b-agent"
      ],
      "metrics_url": "http://builder-b.example.internal:9100/metrics",
      "filesystem_mountpoint": "/",
      "io_pressure_stop_pct": 40,
      "io_pressure_resume_pct": 15
    },
    {
      "name": "builder-c",
      "agent_names": [
        "builder-c-slot-1",
        "builder-c-slot-2",
        "builder-c-slot-3",
        "builder-c-slot-4"
      ],
      "metrics_url": "http://builder-c.example.internal:9100/metrics",
      "filesystem_mountpoint": "/",
      "graded": {
        "min_open_slots": 1,
        "load_per_cpu_full": 0.5,
        "memory_full_pct": 50,
        "open_samples": 6,
        "close_samples": 2
      }
    }
  ]
}
