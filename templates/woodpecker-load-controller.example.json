{
  "version": 2,
  "woodpecker_url": "https://ci.example.com",
  "interval_seconds": 30,
  "minimum_schedulable_nodes": 1,
  "stop_samples": 10,
  "resume_samples": 20,
  "thresholds": {
    "cpu_stop_pct": 85,
    "cpu_resume_pct": 60,
    "memory_stop_pct": 15,
    "memory_resume_pct": 30,
    "disk_stop_pct": 10,
    "disk_resume_pct": 15
  },
  "nodes": [
    {
      "name": "builder-a",
      "agent_names": [
        "builder-a-agent-1",
        "builder-a-agent-2"
      ],
      "metrics_url": "http://builder-a.example.internal:9100/metrics",
      "filesystem_mountpoint": "/",
      "backing_storage": {
        "metrics_url": "http://hypervisor.example.internal:9100/metrics",
        "filesystem_mountpoint": "/",
        "filesystem_device": "/dev/md3",
        "disk_stop_pct": 10,
        "disk_resume_pct": 15,
        "minimum_free_bytes": 53687091200
      }
    },
    {
      "name": "builder-b",
      "agent_names": [
        "builder-b-agent"
      ],
      "metrics_url": "http://builder-b.example.internal:9100/metrics",
      "filesystem_mountpoint": "/",
      "admission_hold": false,
      "io_pressure_stop_pct": 40,
      "io_pressure_resume_pct": 15
    },
    {
      "name": "builder-c",
      "agent_names": [
        "builder-c-slot-1",
        "builder-c-slot-2",
        "builder-c-slot-3",
        "builder-c-slot-4"
      ],
      "metrics_url": "http://builder-c.example.internal:9100/metrics",
      "filesystem_mountpoint": "/",
      "physical_memory": {
        "expected_nodename": "pve-example",
        "stop_pct": 10,
        "resume_pct": 15,
        "prometheus": {
          "url": "http://100.64.0.1:9090/api/v1/query",
          "proxy_url": "http://127.0.0.1:1056",
          "job": "node-exporter",
          "host": "pve-example",
          "instance": "100.64.0.2:9100",
          "fleet": "example",
          "role": "hypervisor",
          "max_age_seconds": 60,
          "max_skew_seconds": 5
        }
      },
      "graded": {
        "min_open_slots": 1,
        "load_per_cpu_full": 0.5,
        "memory_full_pct": 50,
        "open_samples": 6,
        "close_samples": 2
      }
    }
  ]
}
