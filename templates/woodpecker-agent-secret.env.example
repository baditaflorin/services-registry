# Copy to .agent-secret.env, set mode 0600, and load from the private secret store.
# The Compose template maps this same control-plane value to Woodpecker 3.17's
# WOODPECKER_GRPC_SECRET; do not create a second, different gRPC credential.
# Never commit the populated file.
WOODPECKER_AGENT_SECRET=replace-with-control-plane-agent-secret
